# ML PRACTICAL 4
# Sales Data Clustering using K-Means Algorithm
#
# AIM:
# To implement K-Means clustering on sales_data_sample.csv
# and determine the optimal number of clusters using Elbow Method.

# FEATURES USED FOR CLUSTERING:
# 1. PRICEEACH:
#    It represents the price of each product per unit.
#
# 2. MSRP:
#    It represents the manufacturer's suggested retail price.
#
# PURPOSE:
# These two features are used to group similar sales records
# into clusters based on their price values.
# STEP 1: Import required libraries

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns


# STEP 2: Load the sales dataset

df = pd.read_csv('sales_data_sample.csv', encoding='latin1')

# Display first five records
print("First Five Records:")
print(df.head())


# STEP 3: Check dataset dimensions

print("\nDataset Shape:")
print(df.shape)


# STEP 4: Display dataset information

print("\nDataset Information:")
df.info()


# STEP 5: Display statistical summary

print("\nStatistical Summary:")
print(df.describe())


# STEP 6: Visualize correlation using a heatmap

plt.figure(figsize=(12, 10))

sns.heatmap(
    df.corr(numeric_only=True),
    annot=True,
    fmt='.2f'
)

plt.title("Correlation Heatmap")
plt.show()


# STEP 7: Select features for clustering

df = df[['PRICEEACH', 'MSRP']]

# Display selected columns
print("\nSelected Features:")
print(df.head())


# STEP 8: Check missing values

print("\nMissing Values:")
print(df.isna().any())


# STEP 9: Display statistical summary of selected features

print("\nSelected Features Summary:")
print(df.describe().T)


# STEP 10: Display dataset dimensions

print("\nSelected Dataset Shape:")
print(df.shape)


# STEP 11: Perform feature scaling using StandardScaler

from sklearn.preprocessing import StandardScaler

# Create the scaler
scaler = StandardScaler()

# Fit and transform the data
scaled_data = scaler.fit_transform(df)


# STEP 12: Find optimal number of clusters using Elbow Method

from sklearn.cluster import KMeans

# Create an empty list to store inertia values
inertia = []

# Test different numbers of clusters from 1 to 10
for i in range(1, 11):

    # Create the K-Means model
    clusters = KMeans(
        n_clusters=i,
        init='k-means++',
        random_state=42,
        n_init=10
    )

    # Fit the model on scaled data
    clusters.fit(scaled_data)

    # Store inertia value
    inertia.append(clusters.inertia_)

# Plot the Elbow graph
plt.figure(figsize=(6, 6))

sns.lineplot(
    x=list(range(1, 11)),
    y=inertia,
    marker='o'
)

plt.xlabel("Number of Clusters")
plt.ylabel("Inertia")
plt.title("Elbow Method")
plt.show()

# Observation:
# The elbow appears around 3 clusters.
# Therefore, we select K = 3.


# STEP 13: Apply K-Means algorithm with 3 clusters

# Create the K-Means model
kmeans = KMeans(
    n_clusters=3,
    random_state=42,
    n_init=10
)

# Fit the model and predict cluster labels
y_kmeans = kmeans.fit_predict(scaled_data)

# Display cluster labels
print("\nCluster Labels:")
print(y_kmeans)


# STEP 14: Visualize clusters and their centroids

# Convert scaled centroid coordinates into original values
centroids = scaler.inverse_transform(kmeans.cluster_centers_)

# Set graph size
plt.figure(figsize=(8, 8))

# Display clusters using scatter plot
sns.scatterplot(
    x=df['PRICEEACH'],
    y=df['MSRP'],
    hue=y_kmeans,
    palette='viridis'
)

# Display centroids using red stars
plt.scatter(
    centroids[:, 0],
    centroids[:, 1],
    c='red',
    marker='*',
    s=200,
    label='Centroids'
)

# Add graph labels and title
plt.xlabel("PRICEEACH")
plt.ylabel("MSRP")
plt.title("K-Means Clustering")
plt.legend()

# Display the graph
plt.show()


# STEP 15: Display coordinates of cluster centres

print("\nCoordinates of Cluster Centres:")
print(centroids)


# CONCLUSION:
# The K-Means clustering algorithm was successfully implemented
# on the sales dataset using PRICEEACH and MSRP features.
# Feature scaling was performed using StandardScaler.
# The Elbow Method was used to determine the optimal number
# of clusters. The dataset was divided into three clusters,
# and the clusters and their centroids were visualized
# using a scatter plot.
